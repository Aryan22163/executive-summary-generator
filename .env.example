# ==============================================================================
# Executive Summary Generator — Environment Configuration
# ==============================================================================

# Hugging Face Open Source API Token (Free / Pro)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Recommended Open Source Models on Hugging Face:
# - meta-llama/Llama-3.3-70B-Instruct (High-intelligence 70B reasoning)
# - meta-llama/Meta-Llama-3-8B-Instruct (Fast 8B inference)
# - mistralai/Mistral-7B-Instruct-v0.3 (Mistral 7B)
# - Qwen/Qwen2.5-72B-Instruct (Qwen 72B)
# - deepseek-ai/DeepSeek-R1-Distill-Qwen-32B (DeepSeek Reasoning)

# Optional Google Gemini API Key
GEMINI_API_KEY=
